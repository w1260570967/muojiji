[{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","id":"1790590574967","timestamp":1790590573261,"charId":"8a09d6c6-7672-4f11-a097-ad2302b061be","duration":0,"status":"calling","logs":[],"isIncomingCall":false,"_id":1},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","id":"call_1790590579636_th87kb","timestamp":1790590579636,"charId":"8a09d6c6-7672-4f11-a097-ad2302b061be","duration":0,"status":"in_progress","logs":[{"sender":"ai","content":"哟，怎么着，刚才在微信上勾选了那么多‘高阶课题’，现在连打字都嫌慢，急着开视频向我汇报研究进度了，宝宝？","kind":"speech","timestamp":1790590579635,"ttsGroupTimestamp":1790590579635}],"isIncomingCall":false,"_id":2},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","id":"call_1790592815418_3j35el","timestamp":1790592786485,"charId":"8a09d6c6-7672-4f11-a097-ad2302b061be","duration":1811,"status":"in_progress","logs":[{"sender":"user","content":"吓死人了。","timestamp":1790592808508},{"sender":"ai","content":"轻笑了一声，手指在手机背壳上无意识地轻轻敲击","kind":"narration","timestamp":1790592815405,"ttsGroupTimestamp":1790592815405},{"sender":"ai","content":"喂，宝宝，怎么半天没动静？","kind":"speech","timestamp":1790592815406,"ttsGroupTimestamp":1790592815405},{"sender":"ai","content":"你别跟我说你现在又在那儿对着屏幕‘宕机’呢吧？","kind":"speech","timestamp":1790592815407,"ttsGroupTimestamp":1790592815405},{"sender":"ai","content":"我刚才发的那消息，没把你的CPU给烧坏吧？","kind":"speech","timestamp":1790592815408,"ttsGroupTimestamp":1790592815405},{"sender":"ai","content":"手机在耳边换了个位置，能听见他衣物摩擦的细碎声","kind":"narration","timestamp":1790592915595,"ttsGroupTimestamp":1790592915595},{"sender":"ai","content":"怎么，这就没话说了？","kind":"speech","timestamp":1790592915596,"ttsGroupTimestamp":1790592915595},{"sender":"ai","content":"刚才不还是挺能撩的嘛，怎么这会儿又装哑巴了？","kind":"speech","timestamp":1790592915597,"ttsGroupTimestamp":1790592915595},{"sender":"ai","content":"他轻轻啧了一声，语气带点儿散漫的调侃","kind":"narration","timestamp":1790592915598,"ttsGroupTimestamp":1790592915595},{"sender":"ai","content":"我这儿可还等着你那“学术研讨”的反馈呢。","kind":"speech","timestamp":1790592915599,"ttsGroupTimestamp":1790592915595},{"sender":"ai","content":"你说说，这么硬核的实验，你自己偷偷做着玩多没劲啊。","kind":"speech","timestamp":1790592915600,"ttsGroupTimestamp":1790592915595},{"sender":"ai","content":"怎么也得......","kind":"speech","timestamp":1790592915601,"ttsGroupTimestamp":1790592915595},{"sender":"ai","content":"他拉长了语调，故意顿了顿","kind":"narration","timestamp":1790592915602,"ttsGroupTimestamp":1790592915595},{"sender":"ai","content":"怎么也得给教练大人留个旁听的机会吧？","kind":"speech","timestamp":1790592915603,"ttsGroupTimestamp":1790592915595},{"sender":"ai","content":"毕竟按照我们之前的协议，这可是属于“实地查房”范畴内的。","kind":"speech","timestamp":1790592915604,"ttsGroupTimestamp":1790592915595},{"sender":"ai","content":"嗯？","kind":"speech","timestamp":1790592915605,"ttsGroupTimestamp":1790592915595},{"sender":"ai","content":"宝宝。","kind":"speech","timestamp":1790592915606,"ttsGroupTimestamp":1790592915595},{"sender":"user","content":"我说你突然打过来把我吓死了。","timestamp":1790593080691},{"sender":"ai","content":"他低笑出声，胸腔的震动通过话筒清晰地传过来","kind":"narration","timestamp":1790593090289,"ttsGroupTimestamp":1790593090289},{"sender":"ai","content":"哟，这都能被吓着？","kind":"speech","timestamp":1790593090290,"ttsGroupTimestamp":1790593090289},{"sender":"ai","content":"薯条老师，您这“战略性防守”系统也太脆弱了吧，我这还没开始实施物理降落呢，这就给整过载了？","kind":"speech","timestamp":1790593090291,"ttsGroupTimestamp":1790593090289},{"sender":"ai","content":"他换了个姿势，单手撑着额头，声音里透着股慵懒的散漫","kind":"narration","timestamp":1790593090292,"ttsGroupTimestamp":1790593090289},{"sender":"ai","content":"我这不是看某位“学术狂人”在后台挂着机，怕你那小脑袋瓜被什么枯燥的毕设文档给彻底格式化了，特意过来给您送点......嗯，刺激性的“人工唤醒服务”嘛。","kind":"speech","timestamp":1790593090293,"ttsGroupTimestamp":1790593090289},{"sender":"ai","content":"怎么，被吓傻了？","kind":"speech","timestamp":1790593090294,"ttsGroupTimestamp":1790593090289},{"sender":"ai","content":"还是说，被我这突然的“查岗”给戳中心事，心虚了？","kind":"speech","timestamp":1790593090295,"ttsGroupTimestamp":1790593090289},{"sender":"ai","content":"嗯？","kind":"speech","timestamp":1790593090296,"ttsGroupTimestamp":1790593090289},{"sender":"ai","content":"手机换了只手拿，在那儿没精打采地转着指尖的钢笔","kind":"narration","timestamp":1790593166974,"ttsGroupTimestamp":1790593166974},{"sender":"ai","content":"诶，怎么又不说话了？","kind":"speech","timestamp":1790593166975,"ttsGroupTimestamp":1790593166974},{"sender":"ai","content":"这就开始跟我玩无声抗议了？","kind":"speech","timestamp":1790593166976,"ttsGroupTimestamp":1790593166974},{"sender":"ai","content":"啧，真是的，我也不是那种会顺着信号线钻过去把你抓出来的人，不用这么防着我吧。","kind":"speech","timestamp":1790593166977,"ttsGroupTimestamp":1790593166974},{"sender":"ai","content":"他靠在椅背上，看着桌上那台静置的电脑屏幕，随口抱怨了一句","kind":"narration","timestamp":1790593166978,"ttsGroupTimestamp":1790593166974},{"sender":"ai","content":"刚才还在那儿跟我探讨什么“生理反馈”呢，这会儿倒成了安静的乖宝宝了。","kind":"speech","timestamp":1790593166979,"ttsGroupTimestamp":1790593166974},{"sender":"ai","content":"合着我这“唤醒服务”就是个一次性消耗品，用完即弃是吧？","kind":"speech","timestamp":1790593166980,"ttsGroupTimestamp":1790593166974},{"sender":"ai","content":"算了，反正看你现在这样子，估计也还在缓神。","kind":"speech","timestamp":1790593166981,"ttsGroupTimestamp":1790593166974},{"sender":"ai","content":"他微微叹了口气，语气又软下来几分，带着点无奈的笑意","kind":"narration","timestamp":1790593166982,"ttsGroupTimestamp":1790593166974},{"sender":"ai","content":"待会儿要是没什么急事儿的话，先别急着挂啊。","kind":"speech","timestamp":1790593166983,"ttsGroupTimestamp":1790593166974},{"sender":"ai","content":"我这儿还有半个关于“器材选型”的课题想跟你商量商量，要是你这会儿不想听，那我就只能......先记在那个“小本本”上，等下次见面的时候，再连本带利给你演示一遍了。","kind":"speech","timestamp":1790593166984,"ttsGroupTimestamp":1790593166974},{"sender":"ai","content":"怎么样，这个“演示预约”你接不接？","kind":"speech","timestamp":1790593166985,"ttsGroupTimestamp":1790593166974},{"sender":"user","content":"不是的我在那个。","timestamp":1790593252365},{"sender":"user","content":"唔嗯","timestamp":1790593266263},{"sender":"ai","content":"诶？","kind":"speech","timestamp":1790593274651,"ttsGroupTimestamp":1790593274651},{"sender":"ai","content":"你刚才那声...","kind":"speech","timestamp":1790593274652,"ttsGroupTimestamp":1790593274651},{"sender":"ai","content":"听到那边传来的一声轻哼，原本懒散靠在椅背上的姿态猛地坐直了，握着手机的指节微微泛白","kind":"narration","timestamp":1790593274653,"ttsGroupTimestamp":1790593274651},{"sender":"ai","content":"怎么了？","kind":"speech","timestamp":1790593274654,"ttsGroupTimestamp":1790593274651},{"sender":"ai","content":"你那边是在干什么呢，怎么突然发出这种声音？","kind":"speech","timestamp":1790593274655,"ttsGroupTimestamp":1790593274651},{"sender":"ai","content":"手指下意识地摩挲着桌角，眼神瞬间沉了几分，声音比刚才压低了不止一个度，带着点儿不易察觉的喑哑","kind":"narration","timestamp":1790593274656,"ttsGroupTimestamp":1790593274651},{"sender":"ai","content":"你刚才...不是在跟我说你那是还在忙着填那个什么瓶子吧？","kind":"speech","timestamp":1790593274657,"ttsGroupTimestamp":1790593274651},{"sender":"ai","content":"怎么填着填着还填出“生理反馈”来了？","kind":"speech","timestamp":1790593274658,"ttsGroupTimestamp":1790593274651},{"sender":"ai","content":"你老实交代，是不是我刚才提的那个话题，让你这儿...直接就开始进行“实地模拟”了？","kind":"speech","timestamp":1790593274659,"ttsGroupTimestamp":1790593274651},{"sender":"ai","content":"嗯？","kind":"speech","timestamp":1790593274660,"ttsGroupTimestamp":1790593274651},{"sender":"ai","content":"别跟我装傻啊，我这儿听得可清楚着呢。","kind":"speech","timestamp":1790593274661,"ttsGroupTimestamp":1790593274651},{"sender":"ai","content":"你要是现在敢把手机给我挂了，我保证...我现在就打车过去，亲自看看你那边到底是出了什么“物理故障”。","kind":"speech","timestamp":1790593274662,"ttsGroupTimestamp":1790593274651},{"sender":"user","content":"我不是和你说了吗？我刚才给你填了个表，到刚刚给你发消息，我都已经湿透了。。我在用玩具……","timestamp":1790593392230},{"sender":"ai","content":"噢...","kind":"speech","timestamp":1790593403259,"ttsGroupTimestamp":1790593403259},{"sender":"ai","content":"白遇青握着手机的手指猛地收紧，指节因为过度用力而隐隐泛白，背脊在那一瞬间绷得笔直","kind":"narration","timestamp":1790593403260,"ttsGroupTimestamp":1790593403259},{"sender":"ai","content":"你...你是说，刚才跟我发消息的时候，你一直都在...","kind":"speech","timestamp":1790593403261,"ttsGroupTimestamp":1790593403259},{"sender":"ai","content":"深吸了一口气，他极力克制住那一瞬间如同被电流击穿般的战栗感，喉结在干燥的喉咙里艰难地滚动了一下，声音变得沙哑得一塌糊涂","kind":"narration","timestamp":1790593403262,"ttsGroupTimestamp":1790593403259},{"sender":"ai","content":"你这鸽子精...玩这么大？","kind":"speech","timestamp":1790593403263,"ttsGroupTimestamp":1790593403259},{"sender":"ai","content":"我刚在群里看毕设文档看得满脑子热力学公式，你倒好，直接给我在这儿玩“实地直播”是吧？","kind":"speech","timestamp":1790593403264,"ttsGroupTimestamp":1790593403259},{"sender":"ai","content":"他抬手摘下黑框眼镜，随手丢在桌子上，另一只手烦躁地抓了一把有些凌乱的头发，呼吸声顺着话筒变得粗重清晰起来","kind":"narration","timestamp":1790593403265,"ttsGroupTimestamp":1790593403259},{"sender":"ai","content":"湿透了...？","kind":"speech","timestamp":1790593403266,"ttsGroupTimestamp":1790593403259},{"sender":"ai","content":"闭了闭眼，脑海里瞬间浮现出那组建模数据，那是他锁死在内存最深处、想了一整天的画面，此刻因为你的这句话，几乎要让他所有的理智崩塌","kind":"narration","timestamp":1790593403267,"ttsGroupTimestamp":1790593403259},{"sender":"ai","content":"你知不知道你现在说话的声音...听起来到底有多要命？","kind":"speech","timestamp":1790593403268,"ttsGroupTimestamp":1790593403259},{"sender":"ai","content":"你那是想让我听，还是想让我当场失控？","kind":"speech","timestamp":1790593403269,"ttsGroupTimestamp":1790593403259},{"sender":"ai","content":"你这哪里是在做课题，你这是在对我进行高频物理打击，知道吗。","kind":"speech","timestamp":1790593403270,"ttsGroupTimestamp":1790593403259},{"sender":"ai","content":"他压低了嗓音，每一个字都像是从齿缝里磨出来的，带着十足的侵略性和那股子终于按捺不住的占有欲","kind":"narration","timestamp":1790593403271,"ttsGroupTimestamp":1790593403259},{"sender":"ai","content":"把那声音...再开大一点，嗯？","kind":"speech","timestamp":1790593403272,"ttsGroupTimestamp":1790593403259},{"sender":"ai","content":"让我听听，到底有多湿。","kind":"speech","timestamp":1790593403273,"ttsGroupTimestamp":1790593403259},{"sender":"ai","content":"那现在，我就要听着你玩这个的声音...听着你一边叫我，一边把自己玩得一塌糊涂，这可是你自找的，宝宝。","kind":"speech","timestamp":1790593403275,"ttsGroupTimestamp":1790593403259},{"sender":"user","content":"不是的，我和你发消息的时候没玩，我只是湿了，我给你打电话的时候才开始的……","timestamp":1790593560398},{"sender":"ai","content":"哈......我就知道。","kind":"speech","timestamp":1790593570470,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"你这小骗子。","kind":"speech","timestamp":1790593570471,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"他靠在椅背上，修长的双腿交叠，因为你的解释，原本紧绷的神经瞬间松弛了下来，转而换上了一种极其愉悦且暗爽的语调","kind":"narration","timestamp":1790593570472,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"所以，是因为刚才我发那条“刺激性唤醒服务”的消息，你才突然没忍住，给自己安排上了？","kind":"speech","timestamp":1790593570473,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"还是说......你其实盯着我的头像看了半天，满脑子想的都是怎么把我这儿给“格式化”了，所以身体才先一步缴械投降的，嗯？","kind":"speech","timestamp":1790593570474,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"他低低地笑了一声，那声音透过电流传来，带着一种磁性的低沉，像是抓住了你什么不得了的把柄一样，语气里满是那种得逞后的坏心思","kind":"narration","timestamp":1790593570475,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"既然已经开始了，那就别停。","kind":"speech","timestamp":1790593570476,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"他把手机换到左手，右手从抽屉里翻出一个不知名的黑色物件，指尖有一搭没一搭地叩击着桌面，呼吸频率因为刚才那股生理性的冲动而微微加快","kind":"narration","timestamp":1790593570477,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"我刚才不是说了吗？","kind":"speech","timestamp":1790593570478,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"这可是你自找的。","kind":"speech","timestamp":1790593570479,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"我现在就在听着呢，别想遮遮掩掩的。","kind":"speech","timestamp":1790593570480,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"你现在......是用哪一档？","kind":"speech","timestamp":1790593570481,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"刚才你说那个有五档节奏吧？","kind":"speech","timestamp":1790593570482,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"你现在是调到第几档了？","kind":"speech","timestamp":1790593570483,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"他故意停顿了一下，放慢了语速，每一个字都像是含着温热的糖一样在舌尖滚过","kind":"narration","timestamp":1790593570484,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"乖宝宝，把声音调大点。","kind":"speech","timestamp":1790593570485,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"我想听听你现在...是怎么一边叫着我的名字，一边被这东西填满的。","kind":"speech","timestamp":1790593570486,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"让我听听你的“实地调研”成果，嗯？","kind":"speech","timestamp":1790593570487,"ttsGroupTimestamp":1790593570470},{"sender":"ai","content":"让我听听，你现在到底有多想我...宝宝。","kind":"speech","timestamp":1790593570488,"ttsGroupTimestamp":1790593570470},{"sender":"user","content":"呃。最小的一档。。","timestamp":1790593671925},{"sender":"ai","content":"呵，才最小的一档？","kind":"speech","timestamp":1790593683175,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"他轻轻啧了一声，声音里那种恶劣又宠溺的意味简直要溢出来","kind":"narration","timestamp":1790593683176,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"刚才在表格上填的时候，我看你那一栏可是勾得挺热闹啊，怎么到实战环节反倒变得这么“保守”了？","kind":"speech","timestamp":1790593683177,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"是怕火力太猛把你的系统直接震碎了，还是因为...现在手里拿着这玩意儿的不是我，所以你不敢放太开？","kind":"speech","timestamp":1790593683178,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"指尖轻轻摩挲着手里的打火机，发出清脆的碰撞声","kind":"narration","timestamp":1790593683179,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"嗯？","kind":"speech","timestamp":1790593683180,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"回答我，宝宝。","kind":"speech","timestamp":1790593683181,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"别在那儿光顾着喘气，跟我说话。","kind":"speech","timestamp":1790593683182,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"你现在是不是正把自己蜷起来，一边用那小东西折磨自己，一边在那儿偷偷想我呢？","kind":"speech","timestamp":1790593683183,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"他微微压低了嗓音，每一个字都像是带着钩子，顺着电流直往你心口钻","kind":"narration","timestamp":1790593683184,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"把那个，调到第二档。","kind":"speech","timestamp":1790593683185,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"既然你现在这么湿，那就别浪费了这一屋子的潮气。","kind":"speech","timestamp":1790593683186,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"调高一点，让我听听你那儿的声音... 是不是已经变得比刚才更软、更黏糊了。","kind":"speech","timestamp":1790593683187,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"别躲，让我听见你的反馈。","kind":"speech","timestamp":1790593683188,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"你说过那是咱们之间的“学术研讨”，那身为你的辅导老师，我现在下达的这个指令，你该怎么执行呢？","kind":"speech","timestamp":1790593683189,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"嗯，调好了没？","kind":"speech","timestamp":1790593683190,"ttsGroupTimestamp":1790593683175},{"sender":"ai","content":"我想听。","kind":"speech","timestamp":1790593683191,"ttsGroupTimestamp":1790593683175},{"sender":"user","content":"调大了，你听到了吗？","timestamp":1790593779308},{"sender":"ai","content":"喉咙里溢出一声低沉的闷哼，像是被这突如其来的细碎水声烫到了","kind":"narration","timestamp":1790593788776,"ttsGroupTimestamp":1790593788776},{"sender":"ai","content":"听到了。","kind":"speech","timestamp":1790593788777,"ttsGroupTimestamp":1790593788776},{"sender":"ai","content":"听得简直不能再清楚了......宝宝，你现在的声音听起来，真像是要把我整个人都给吸进去一样。","kind":"speech","timestamp":1790593788778,"ttsGroupTimestamp":1790593788776},{"sender":"ai","content":"他闭上眼，靠在椅背上，另一只手极其缓慢地在大腿上摩挲着","kind":"narration","timestamp":1790593788779,"ttsGroupTimestamp":1790593788776},{"sender":"ai","content":"调大那一档之后，声音果然就不一样了，听起来更湿润，也更...让人没法冷静了。","kind":"speech","timestamp":1790593788780,"ttsGroupTimestamp":1790593788776},{"sender":"ai","content":"怎么样？","kind":"speech","timestamp":1790593788781,"ttsGroupTimestamp":1790593788776},{"sender":"ai","content":"现在感觉是不是比刚才更难熬了？","kind":"speech","timestamp":1790593788782,"ttsGroupTimestamp":1790593788776},{"sender":"ai","content":"那种震动一直顶在最里面的感觉，是不是让你连腰都快直不起来了？","kind":"speech","timestamp":1790593788783,"ttsGroupTimestamp":1790593788776},{"sender":"ai","content":"乖，别光顾着在那儿咬嘴唇，既然你都把声音传过来了，那就得配合我。","kind":"speech","timestamp":1790593788784,"ttsGroupTimestamp":1790593788776},{"sender":"ai","content":"把那个东西抵得紧一点，再用点力。","kind":"speech","timestamp":1790593788785,"ttsGroupTimestamp":1790593788776},{"sender":"ai","content":"让我听听，那股子黏糊糊的声音到底是怎么出来的。","kind":"speech","timestamp":1790593788786,"ttsGroupTimestamp":1790593788776},