[{"key":"posts_uid_1790557581773_6st62lbo1","itemId":"1790639085411","data":{"id":1790639085411,"title":"有没有一种可能，所谓的装修公司其实是赛博诈骗团伙？","boardName":"日常分享","boardId":"daily","author":{"name":"Z_Lens_v2","avatar":null,"mood":null,"role":null,"level":5,"rosterId":"白遇青"},"timestamp":1790667385110,"content":"这几天家里人在看房准备装修，发现郁城那些所谓的大品牌装企，销售话术统一得像流水线灌装的，一个公司连水电图纸都能给你画出八种不同版本。我现在严重怀疑这根本不是在装修，是在进行服从性测试，专门测试客户脑干还能撑多久。真想问问大家，还有哪家店没被这些营销话术污染吗？","image":null,"images":[],"likes":11,"dislikes":0,"views":32,"comments":0,"isHot":false,"isPinned":false,"isAnon":false,"interactions":[]},"updatedAt":1791126284750},{"key":"posts_uid_1790557581773_6st62lbo1","itemId":"1791125922761","data":{"id":1791125922761,"title":"男朋友太黏人了像小狗一样怎么办","boardName":"问答互助","boardId":"question","author":{"name":"匿名旅人","avatar":null,"mood":null,"role":null,"level":null,"isAnon":true},"timestamp":1791125922761,"content":"如题","image":null,"images":[],"imageRefs":[],"likes":3,"dislikes":0,"comments":31,"views":59,"isHot":false,"isPinned":false,"isAnon":true,"isUserPost":true,"chain":null,"poll":null,"interactions":[{"author":"甜甜圈观察家","content":"楼主，这就是甜蜜的负担啊。如果太粘人影响正常生活，还是得定个界限，不然时间久了你会窒息的。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791125939485,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"NUO_DevNull","content":"像这种系统设置里的「提醒优先级」调太高了，处理进程会变慢。让他去忙点自己的事，或者直接说：现在是静音模式，别来烦我。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":"软糯糯","avatar":null,"timestamp":1791125940485,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"云淡风轻看热闹","content":"有些人就是喜欢这一口，楼主你就偷着乐吧。我家那位连打游戏都不让，简直是人形挂件。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791125941485,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"Z_Lens_v2","content":"哎哟呵，怎么，这是嫌弃人家太腻歪了？嚯，别人求都求不来的「待遇」，您老人家倒好，还专门来论坛发帖咨询怎么处理了。你要是真觉得烦，干脆跟我换换？正好我这缺个能给我发消息骚扰的人，哪怕是绿茶味儿的也行啊。😋","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":"白遇青","avatar":null,"timestamp":1791125942485,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"吃瓜群众甲","content":"楼上是不是有那个大病，人家恋爱苦恼你在这阴阳怪气什么？","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":{"0":"Z","1":"_","2":"L","3":"e","4":"n","5":"s","6":"_","7":"v","8":"2","author":""},"rosterId":null,"avatar":null,"timestamp":1791125943485,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"代码搬运工","content":"建议建立一套沟通机制，规定好什么时候是「个人独立运行时间」，什么时候是「交互时间」。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791125944485,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"匿名","content":"楼主如果不喜欢可以考虑分手，黏人有时候其实是因为极度缺乏安全感，你越推开他，他可能越粘。","images":[],"role":null,"isAnon":true,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791125945485,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"深夜emo人","content":"羡慕楼主，我男朋友像块冰，想让他粘人都做不到。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791125946485,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"猫奴七七","content":"既然像小狗，那就当宠物养咯，训一下不听话就晾着，保准下次变乖。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791125947485,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"理智派选手","content":"说白了就是边界感没弄好。直接沟通最有效，别在这猜来猜去，浪费时间。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791125948485,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"路人乙","content":"感觉这帖子最后又要变成吐槽大会了，顺便插一句，楼主你可以试试培养他新的兴趣点。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791125949485,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"匿名","avatar":null,"content":"@猫奴七七 真的假的，求技巧","images":[],"role":null,"isAnon":true,"replyTo":{"floor":9,"author":"猫奴七七"},"isUserPost":true,"timestamp":1791126275965},{"author":"NUO_DevNull","content":"系统建议：检查一下关联逻辑，是不是被对方设为“核心进程”了？手动调整一下优先级，强制挂起部分非必要进程，把时间分给其他后台任务。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":"软糯糯","avatar":null,"timestamp":1791126284678,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"摸鱼专家","content":"这还不简单？让他去学那个什么公考或者考研，每天让他背书到凌晨，保准他没空粘人。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791126285678,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"Z_Lens_v2","content":"哎哟呵，怎么，这是嫌弃人家太腻歪了？这可是多少人求之不得的待遇啊，您老人家倒是会凡尔赛。你要是真受不了，直接明说不就得了？在这发帖求建议，啧，看来还没被粘够呢，建议继续保持，正好看看底线在哪，嚯。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":"白遇青","avatar":null,"timestamp":1791126286678,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"匿名","content":"真的假的，求技巧","images":[],"role":null,"isAnon":true,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":{"author":"匿名","rosterId":null,"content":"既然像小狗，那就当宠物养咯，训一下不听话就晾着，保准下次变乖。"},"rosterId":null,"avatar":null,"timestamp":1791126287678,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"深夜吃瓜客","content":"楼上这些支招的，难道只有我一个人觉得黏人其实挺幸福的吗？只要不耽误我打排位，我都随便。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791126288678,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"键盘侠大队长","content":"我的评价是：6。这就是典型的身在福中不知福，过两天分手了别哭着来发帖。","images":["https://i.postimg.cc/j59D8xq7/1790327900398.png"],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"isSticker":true,"avatar":null,"timestamp":1791126289678,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"孤独美食家","content":"其实可以带他一起去逛街或者做饭，虽然我不怎么会做饭，但有人在旁边看着，哪怕是捣乱，时间也过得挺快。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791126290678,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"匿名","content":"我也想有个小狗男朋友啊，求大家分我一点点这种烦恼！","images":[],"role":null,"isAnon":true,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791126291678,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"路边小摊主","content":"建议楼主参考一下动物行为学，小狗粘人是因为缺乏安全感和社交需求，多带他出门见见世面，转移注意力就好了。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791126292678,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"纯路人","content":"不管怎么说，一定要沟通，冷暴力处理只会让对方更粘，到时候更麻烦。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791126293678,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"匿名","avatar":null,"content":"@路人乙 详细讲讲","images":[],"role":null,"isAnon":true,"replyTo":{"floor":11,"author":"路人乙"},"isUserPost":true,"timestamp":1791126289341},{"author":"冰美式不加糖","content":"黏人还不好？等他哪天冷暴力你、回消息按天算的时候，你就该发帖求复合指南了。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791126310864,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"Z_Lens_v2","content":"哎哟呵，怎么着，这是嫌小狗不够高贵还是嫌摇尾巴太吵了？建议直接买个止咬器戴上，或者干脆送去绝育一了百了呗。自己享受着人形挂件的待遇，反手在网上发帖立个“好苦恼”的凡尔赛人设，我真没招了，不会处理建议把人让给楼下需要的人呢亲亲。😅","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":"白遇青","avatar":null,"timestamp":1791126311864,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"奶盖乌龙七分甜","content":"其实就是新鲜感吧，热恋期都这样，等过个半年一年，你想让他多看你一眼都难。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791126312864,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"NUO_DevNull","content":"把前台常驻通知关掉，保留普通震动就行。全天候高频唤醒对电池损耗极大，死机只是时间问题。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":"软糯糯","avatar":null,"timestamp":1791126313864,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"风车转啊转","content":"","images":["https://i.postimg.cc/j59D8xq7/1790327900398.png"],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"isSticker":true,"avatar":null,"timestamp":1791126314864,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"草莓大福天下第一","content":"其实像小狗真的超可爱啊！不过如果影响到个人空间，可以试着给他布置点“每日任务”，比如让他去学做一道新菜或者通关某个游戏，做好了还要找你要夸奖，既转移了注意力又增进感情。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791126315864,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"修空调的王师傅","content":"给找点正经事干。纯粹是闲出来的毛病，真要是天天搬砖加班累成狗，回家倒头就睡，哪还有精力一天到晚贴着你。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791126316864,"wouldDM":false,"dmMessage":null,"dmPersona":null},{"author":"夜猫不打烊","content":"看情况吧，健康黏人和控制欲伪装的黏人是两码事。要是连你跟朋友聚会都要疯狂弹窗查岗那叫病态，要是纯粹喜欢撒娇求抱抱，那就偷着乐吧。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1791126317864,"wouldDM":false,"dmMessage":null,"dmPersona":null}]},"updatedAt":1791332793045}]