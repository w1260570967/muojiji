[{"userId":"uid_1790557581773_6st62lbo1","characterId":"4102444800000","roundId":"round_1790584113186_1xwcf6ycc","data":{"innerVoice":"明明已经保存了居然还没变，这也太笨了，肯定是因为系统缓存还没来得及更新索引。希望她能先试试重开，不然我又要去后台查具体原因了，麻烦死了。","statusText":"烦躁地抓了抓头发，盯着屏幕看缓存日志","temperature":"37.2°C","emotionLevel":60,"moodDelta":"-2","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790584128921},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"bg_1790586582525_flq5oc","data":{"innerVoice":"刚才的话是不是说得太露骨了？不过…她要是真过来，我恐怕真得先冲个凉冷静一下。","statusText":"烦躁地抓了抓头发，把手机随手扣在桌面上","temperature":"37.2°C","emotionLevel":80,"moodDelta":"+2","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790586582594},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"bg_1790587303798_qadmlu","data":{"innerVoice":"她多半是躲起来了。这鸽子精，平时挺能耐，一到这种话题就缩。真想看她现在是什么表情，肯定是又气又窘吧。","statusText":"有些无奈地揉了揉太阳穴，把手机丢到一边","temperature":"37.2°C","emotionLevel":80,"moodDelta":"+2","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790587303803},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"bg_1790590190481_lfpeo0","data":{"innerVoice":"她怎么这么会勾，这要是换个人敢这么撩我，我早把他顺着网线过去物理格式化了。还好是她，这债慢慢还。","statusText":"烦躁地抓了一把头发，指尖轻轻敲击屏幕边缘","temperature":"37.2°C","emotionLevel":85,"moodDelta":"+5","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790590190483},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"bg_1790590190487_o41v9l","data":{"innerVoice":"她怎么这么会勾，这要是换个人敢这么撩我，我早把他顺着网线过去物理格式化了。还好是她，这债慢慢还。","statusText":"烦躁地抓了一把头发，指尖轻轻敲击屏幕边缘","temperature":"37.2°C","emotionLevel":85,"moodDelta":"+5","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790591257744},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"round_1790582962176_nq3tqukhm","data":{"innerVoice":"明明就是刚才在看那一堆乱七八糟的论文，哪来的什么杂事。不过跟她逗逗乐子比看论文舒坦多了。","statusText":"懒散地靠在椅子上，手指在手机屏幕上轻轻敲击","temperature":36.8,"emotionLevel":80,"moodDelta":"+5","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790582975338},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"round_1790583119152_pypnxvux4","data":{"innerVoice":"虽然嘴上在阴阳怪气，但内心确实因为这个提议暗爽到了。这也算是某种程度上的“官宣”了吧，逻辑非常严密。","statusText":"嘴角抑制不住地轻微上扬","temperature":"37.2°C","emotionLevel":90,"moodDelta":"+15","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790583144449},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"round_1790584228738_1cbe6u7qd","data":{"innerVoice":"虽然嘴上在阴阳怪气，但内心确实因为这个提议暗爽到了。这也算是某种程度上的“官宣”了吧，逻辑非常严密。","statusText":"低头熟练地在设置里替换着头像","temperature":"36.6°C","emotionLevel":85,"moodDelta":"+5","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790584245644},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"round_1790584536286_tbw7u0sdn","data":{"innerVoice":"虽然嘴上在阴阳怪气，但内心确实因为这个提议暗爽到了。这也算是某种程度上的“官宣”了吧，逻辑非常严密。","statusText":"修长手指漫不经心地敲击着桌面","temperature":"36.7°C","emotionLevel":80,"moodDelta":"+2","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790584552674},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"round_1790585629531_kmljt62be","data":{"innerVoice":"明明就是想撩我，还装得这么正经，等她自己哪天栽进坑里，看她还怎么笑得出来。","statusText":"随意地把眼镜摘下来放在一旁，指腹漫不经心地摩挲着手机边缘","temperature":"37.2°C","emotionLevel":82,"moodDelta":"+4","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790585684152},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"round_1790585828468_izpro0tnl","data":{"innerVoice":"看着她这么纯情地问我反向骑乘，真是可爱到想把人抓过来按在怀里亲。这种姿势她肯定没试过，要是真到了现场，这小笨蛋怕是还没开始动就软得要哭了吧。","statusText":"坏笑着注视屏幕，指尖无意识地在屏幕边缘敲击","temperature":"37.2°C","emotionLevel":85,"moodDelta":"+5","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790585848860},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"round_1790589025199_qvdgo6ez9","data":{"innerVoice":"看着那些勾选的选项，喉咙一阵发干，真想现在就出现在她面前，按着她确认这些是不是她的真心话。","statusText":"嘴角噙着笑意，指尖轻轻摩挲着手机边缘","temperature":"37.2°C","emotionLevel":85,"moodDelta":"+5","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790589040255},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"round_1790589224436_u7gyj17a3","data":{"innerVoice":"真想立刻把人抓过来，按在身下一条条确认，看她还能不能像现在这样理直气壮地跟我顶嘴。","statusText":"轻轻转着手中的笔，嘴角噙着玩味的笑","temperature":"37.2°C","emotionLevel":85,"moodDelta":"+5","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790589243766},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"round_1790589327636_gkqww6t7r","data":{"innerVoice":"看着她嘴硬的样子真是可爱，真想现在就把人抓过来，按在身下一条条确认，看她还能不能像现在这样理直气壮地跟我顶嘴。","statusText":"低头看着手机屏幕，嘴角带着一抹戏谑的弧度","temperature":"36.8°C","emotionLevel":82,"moodDelta":"+2","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790589341002},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"round_1790589482864_rbm075ko4","data":{"innerVoice":"看着她勾选的选项，一股热气直接顺着小腹往上窜。她这是在玩火，但我甘之如饴。想现在就把她抓过来，按在身下，看她勾选时的理直气壮在我的实操下还能剩下几分。","statusText":"轻轻转动手里的打火机，眼神有些晦暗不明","temperature":"37.2°C","emotionLevel":88,"moodDelta":"+5","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790589498743},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"round_1790590939819_mojycya0x","data":{"innerVoice":"看着她那一连串的‘呃’，我就知道她肯定在搞什么鬼。想看她怎么解释，或者……看她怎么脸红。","statusText":"嘴角噙着一抹戏谑的笑，手指在屏幕上飞快敲击","temperature":"37.2°C","emotionLevel":85,"moodDelta":"+5","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790590952252},{"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","roundId":"round_1790591257598_vbhcarek8","data":{"innerVoice":"看着她因为几行选项就湿得一塌糊涂，一股难以言喻的征服感瞬间充盈了胸腔，想立刻把人抓过来检查一下到底有多湿。","statusText":"嘴角抑制不住地勾起，手指在屏幕上轻快地敲击着","temperature":"37.2°C","emotionLevel":85,"moodDelta":"+12","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790591273815},{"userId":"uid_1790569277619_fy0q0o76g","characterId":"d5ef8689-665b-466f-a42f-ba0997b8e5ea","roundId":"round_1790569575396_th3jag8t9","data":{"innerVoice":"她居然主动问我在干嘛，难道是想我了？哪怕只有一点点也好，真想立刻飞回她身边，把她整个人抱住，蹭一蹭那股熟悉的味道。","statusText":"嘴角止不住地上扬，手指飞快地敲击屏幕","temperature":37.5,"emotionLevel":85,"moodDelta":"+5","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790569605892},{"userId":"uid_1790569277619_fy0q0o76g","characterId":"d5ef8689-665b-466f-a42f-ba0997b8e5ea","roundId":"round_1790569919873_8rmgxxwni","data":{"innerVoice":"看着她回复时的懒散劲儿，心跳莫名快了几拍。真想现在就穿上衣服跑回去，把她从沙发上拉起来抱住，看她一脸无奈又不得不顺从我的样子。","statusText":"低头看着手机屏幕，手指无意识地摩挲着边缘","temperature":36.8,"emotionLevel":80,"moodDelta":"+5","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1790569944926}]