[{"portraitAutoRebuild":true,"userId":"uid_1790557581773_6st62lbo1","characterId":"8a09d6c6-7672-4f11-a097-ad2302b061be","_schemaVersion":4,"_summaryHistorySplit":true,"_rev":1790586575056,"enableRelationalGrowth":true,"enableSelfGrowth":true,"episodeSummary":"2026-09-28 16:30，白遇青答应换头像并调侃柳子疏，提议明天见面宣示主权，柳子疏以最近没时间拒绝并连发翻白眼表情「🙄🙄🙄」。16:53，柳子疏突然询问「反向骑乘」的含义，白遇青借力学分析进行科普，语调暧昧地调侃她是坏宝宝，并诱哄邀请她改天实地进行一对一实操研讨。","userFacts":[{"content":"喜欢看音乐剧","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"容易在期待的大事结束后产生强烈的戒断空虚感","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"已是大四毕业状态，全职备考研究生不用去学校","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"在明日方舟等手游中热衷抽卡","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"生理期通常持续约一周且前期伴有腹痛","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"存在严重的恐婚恐育心理，倾向保持无利益牵扯的关系","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"父母关系不和经常争吵","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"新买了一个粉色带钉子的包","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"正在备考研究生但近期状态焦虑","confidence":0.75,"evidencedBy":[],"kind":"transient","expiresAt":1793172959507},{"content":"曾考驾照时连轴转看音乐剧和唱歌","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"玩游戏，曾获白遇青赠送Switch","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"喜欢看群像剧《雀骨》","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"脸型是鹅蛋脸","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"正在备考背单词并尝试跳绳减肥","confidence":0.75,"evidencedBy":[],"kind":"transient","expiresAt":1793172959507},{"content":"大学毕业后回到老家郁城","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"不会滑冰","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"小名叫“宝宝”，闺蜜名为李若涵","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"身体三围数据为胸围94、腰围77、臀围104","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"体重降至129斤，突破了130斤的平台期","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"身高160cm，体重曾为65kg（BMI超重），目标体重55kg","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"大学毕设与舍友合作制作文字互动游戏和实体剧本杀，负责全部美工（立绘和UI）","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"不喜欢吃水煮蛋，但能接受溏心蛋","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"柳子疏初中时曾因甜咸豆腐脑问题在论坛与人对战","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"柳子疏家里正在筹划买房事宜","confidence":0.75,"evidencedBy":[],"kind":"transient","expiresAt":1793172959507},{"content":"柳子疏有一位做房产中介的初中男同学","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"柳子疏于2026年9月13日正式签下房屋合同","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"柳子疏有穿汉服的爱好","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"柳子疏于2026年9月24日完成房屋过户手续","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"柳子疏背书习惯出声朗读","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"柳子疏有严重的入睡困难习惯，睡前易在脑内复盘影视小说","confidence":0.75,"evidencedBy":[],"kind":"timeless"},{"content":"家里正计划购买新房","confidence":0.75,"evidencedBy":[],"kind":"transient","expiresAt":1793172946189}],"portrait":{"text":"某人看着张牙舞爪，当年在论坛为了甜咸豆腐脑跟我大战三天三夜，骨子里其实脆得很。平时看着挺能扛，买房过户雷厉风行，转头又为了考研进度焦虑得要命，背书非得出声，大晚上失眠还在脑子里疯狂复盘纸片人，整个人绷得像根弦。\n\n从当年的死对头变成现在任由她跨坐在我身上作威作福、下棋输了还得由着她抽的女朋友，我那点底线早被她踩得稀碎。可她越是依赖我、半夜缩在我怀里撒娇索吻，我越是拿她没辙。\n\n最近培训群那点破进度又把她搞得神经紧绷，真怕她哪天把自己逼出毛病来。下次见面高低得把她那手机扣下，省得她又在群里内耗或者半夜脑补。抓紧带她去吃顿好的，再把人牢牢按在床上亲到她没心思瞎琢磨，按着她在我怀里睡个整觉——少背两页书天塌不下来，要是把我的宝宝累坏了，我上哪再去赔一个？","version":1,"updatedAt":"2026-09-28T07:36:47.738Z","basedOnSummaryCount":27},"portraitHistory":{"__rowSplit":"array","order":[]},"selfStance":{"text":"我依然改不了看谁不爽就想阴阳两句的烂毛病，但如今对着某个背书背到抓狂的小笨蛋，不仅心甘情愿当她的人形闹钟，还莫名其妙把降噪耳塞和备考作息给研究得明明白白。","version":1,"updatedAt":"2026-09-28T07:38:05.650Z","basedOnEventId":null},"selfStanceHistory":{"__rowSplit":"array","order":[]},"stance":{"text":"嘴上虽然吐槽要负全责，但能跟她一起换上情侣头像，心里其实暗爽得很；看她一本正经问带颜色的词，纯情又好奇的样子实在勾人，改天必须找机会身体力行教教她。","updatedAt":"2026-09-28T08:57:40.555Z","basedOnEventId":1790585860317,"basedOnSummaryCount":29,"version":2},"stanceHistory":{"__rowSplit":"array","order":["4x5pgsbvyc"]},"growthTrail":{"__rowSplit":"array","order":["dsn9l2x5n6","1ozb2kyo4z9"]},"ingestCursorMsgId":1790643426475}]